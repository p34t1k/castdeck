#!/usr/bin/env python3
"""castdeck-native: browser-free screen cast to a Google Cast receiver (experimental, branch 'native')."""
import argparse, signal, sys, os
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from castnative import discover, capture
from castnative.runner import Caster

ap = argparse.ArgumentParser()
ap.add_argument("--list", action="store_true")
ap.add_argument("--name", default="", help="receiver name substring (default: first found)")
ap.add_argument("--host", help="receiver IP, skips discovery")
ap.add_argument("--fps", type=int, default=30)
ap.add_argument("--bitrate", type=int, default=6000, help="kbit/s")
ap.add_argument("--no-audio", action="store_true")
ap.add_argument("--reset", action="store_true", help="forget the saved screen choice")
a = ap.parse_args()
if a.list:
    for d in discover.discover():
        print(f"{d['name']}  {d['host']}:{d['port']}  {d['model']}")
    sys.exit()
if a.reset:
    capture.forget()
host = a.host or (discover.find(a.name) or sys.exit("no receiver found"))["host"]
c = Caster(host, fps=a.fps, vbitrate=a.bitrate, audio=not a.no_audio, log=lambda *m: print(*m, flush=True))
signal.signal(signal.SIGINT, lambda *_: c.stop())
signal.signal(signal.SIGTERM, lambda *_: c.stop())
c.run()
